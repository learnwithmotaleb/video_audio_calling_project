# Copy to .env and replace every change-me value. Never commit .env.

# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated browser origins. Native Flutter apps do not need CORS.
CORS_ORIGINS=http://localhost:3000

# API_PORT and the *_HOST_PORT values are the ports published on the host by Docker Compose.
API_PORT=8000
# 127.0.0.1 keeps the API on this machine. Use 0.0.0.0 to test from phones on the same network.
API_BIND_IP=127.0.0.1

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_USER=communication
POSTGRES_PASSWORD=change-me
POSTGRES_DB=communication

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# Backend-to-LiveKit address. Docker Compose overrides this for the api container.
LIVEKIT_HOST=http://localhost:7880
# Address given to clients. Must be wss:// in production.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Generate the secret with: openssl rand -hex 32
LIVEKIT_API_KEY=change-me
LIVEKIT_API_SECRET=change-me
# Address phones use to reach the media ports: this machine's LAN IP, or the VPS public IP.
LIVEKIT_NODE_IP=127.0.0.1

# Production only, used by docker-compose.prod.yml. All three must point at the VPS.
API_DOMAIN=api.example.com
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com
